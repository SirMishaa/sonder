includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - tests

    # ytmusicapi/ytmusicapi builds YTMusic from traits living in files whose
    # names do not match the trait names (src/mixins/browse.php holds `Browse`),
    # so they are `include`d at runtime rather than autoloaded. Static analysis
    # cannot follow that, and every method on YTMusic reads as undefined
    # without this.
    scanDirectories:
        - vendor/ytmusicapi/ytmusicapi/src

    level: max

    tmpDir: /tmp/phpstan
